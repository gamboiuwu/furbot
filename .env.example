# Copy this file to ".env" and fill in the values for local development.
# In production, set these as environment variables in your host's dashboard.

# --- Required ---
# Your bot token from the Discord Developer Portal > your app > Bot > Reset Token.
DISCORD_TOKEN=

# --- Strongly recommended ---
# Your server's ID. Right-click the server icon > Copy Server ID
# (requires Developer Mode: User Settings > Advanced > Developer Mode).
# Lets slash commands appear instantly instead of taking up to an hour.
GUILD_ID=

# --- Verification flow ---
# The channel where new members post and staff approve them.
VERIFICATION_CHANNEL_ID=
# The role given to verified members.
FLOOFS_ROLE_ID=
# The staff role allowed to approve. If blank, anyone with "Manage Roles" can approve.
STAFF_ROLE_ID=
# Reaction emojis staff use in the verification channel. Defaults shown.
# For a custom server emoji, use just its name, e.g. APPROVAL_EMOJI=verified
APPROVAL_EMOJI=✅
REJECT_EMOJI=❌
WARN_EMOJI=⚠️
# How long a rejected member is banned before being auto-unbanned (hours).
REJECT_COOLDOWN_HOURS=24

# --- Optional ---
# A channel where the bot logs staff actions (verifications, etc.).
LOG_CHANNEL_ID=
# Local folder for the bot's data (cooldowns, audit log, stats). Used as a
# cache/fallback. With Nextcloud set below, the durable copy lives there.
DATA_DIR=data

# --- Nextcloud (Chuu Cloud) storage, optional ---
# If all three are set, the bot keeps its data on your Nextcloud server so it
# survives Railway redeploys. If unset, it just uses local files in DATA_DIR.
# Find your WebDAV URL in Nextcloud: Files > Settings (bottom-left) > WebDAV.
# Point it at a folder you've made for the bot, e.g. .../<username>/FurBot
# Create WEBDAV_PASSWORD as an *app password*: Settings > Security >
# "Create new app password" (never your main account password).
WEBDAV_URL=
WEBDAV_USERNAME=
WEBDAV_PASSWORD=

# --- Unverified-onboarding (all optional) ---
# These are just BOOTSTRAP DEFAULTS. The live values are managed from Discord
# with /config (and saved to Nextcloud), so you normally don't set them here.
# Nothing happens until onboarding is enabled, and every DM/kick still needs a
# staff click in the log channel. The bot needs the "Kick Members" permission.
ONBOARDING_ENABLED=          # true to enable the sweep (default false)
ONBOARDING_REMINDER_HOURS=   # hours unverified before a reminder DM (default 12)
ONBOARDING_KICK_HOURS=       # hours unverified before kick-eligible (default 24)
ONBOARDING_SWEEP_MINUTES=    # how often the sweep runs (default 30)
ONBOARDING_BATCH_CAP=        # max members actioned per confirmed click (default 25)
ONBOARDING_ACTION_DELAY=     # seconds between batch actions (default 1.5)
INVITE_LINK=                 # optional invite shown in the removal DM
